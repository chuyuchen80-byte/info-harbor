# 复制为 .env 后按需修改。后端通过 pydantic-settings 读取（前缀 HARBOR_）。
# 本地默认值与 docker-compose.yml 保持一致。

HARBOR_DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/info_harbor
HARBOR_REDIS_URL=redis://localhost:6379/0
HARBOR_TASK_QUEUE_URL=redis://localhost:6379/1

HARBOR_MINIO_ENDPOINT=localhost:9000
HARBOR_MINIO_ACCESS_KEY=harbor
HARBOR_MINIO_SECRET_KEY=harbor-secret
HARBOR_MINIO_BUCKET=harbor-raw

# 前端允许跨域来源（开发用 Vite 代理则无需改动）
HARBOR_CORS_ORIGINS=["http://localhost:5173"]

# 认证（登录/注册/JWT）
# JWT 签名密钥：生产必须改为随机长字符串（如 `python -c "import secrets;print(secrets.token_hex(32))"`）
HARBOR_JWT_SECRET=change-me-to-a-random-64-hex
HARBOR_JWT_EXPIRE_MINUTES=1440
